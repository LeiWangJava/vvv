      "kind": "array",
      "count": 6,
      "min": 5,
      "max": 10,
      "hint": "the series in story order, landscape 16:9 works best (portrait pictures are shown whole on a blurred copy)"
    }
  },
  "sample": {
    "from": 10,
    "to": 19
  },
