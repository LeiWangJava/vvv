{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "photos": {
      "type": "object",
      "properties": {
        "photo": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "photo"
      ]
    },
    "copy": {
      "type": "object",
      "properties": {}
    },
    "music": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string",
          "description": "public/ 下的音乐路径，如 music/xxx.mp3；留空为无声"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "音量"
        },
        "trimBeforeSec": {
          "type": "number",
          "minimum": 0,
          "description": "从音乐第几秒开始"
        },
        "fadeInSec": {
          "type": "number",
          "minimum": 0
        },
        "fadeOutSec": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "src",
        "volume",
        "trimBeforeSec",
        "fadeInSec",
        "fadeOutSec"
      ]
    },
    "fps": {
      "type": "integer",
      "minimum": 24,
      "maximum": 60,
      "description": "帧率：预览 30，成片 60"
    },
    "format": {
      "description": "画幅，例如 16:9 或 9:16（由工程初始化时选择）",
      "type": "string",
      "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
    }
  },
  "required": [
    "photos",
    "copy",
    "music",
    "fps"
  ]
}
