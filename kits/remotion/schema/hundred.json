{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "photos": {
      "type": "object",
      "properties": {
        "film": {
          "minItems": 3,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "milestones": {
          "minItems": 6,
          "maxItems": 24,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scatter": {
          "minItems": 6,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "floating": {
          "minItems": 6,
          "maxItems": 18,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "wall": {
          "minItems": 9,
          "maxItems": 36,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "film",
        "milestones",
        "scatter",
        "floating",
        "wall"
      ]
    },
    "copy": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "片头标题"
        },
        "subtitle": {
          "type": "string",
          "description": "标题下的小字"
        },
        "greeting": {
          "type": "string",
          "description": "开场一句（手写打字）"
        },
        "letter": {
          "type": "string",
          "description": "第一封信（每行一句，换行分隔）"
        },
        "letter2": {
          "type": "string",
          "description": "第二封信（第一行先慢慢写出，其余逐行发光出现）"
        },
        "ending": {
          "type": "string",
          "description": "结尾一句"
        }
      },
      "required": [
        "title",
        "subtitle",
        "greeting",
        "letter",
        "letter2",
        "ending"
      ]
    },
    "music": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string",
          "description": "public/ 下的音乐路径，如 music/xxx.mp3；留空为无声"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "音量"
        },
        "trimBeforeSec": {
          "type": "number",
          "minimum": 0,
          "description": "从音乐第几秒开始"
        },
        "fadeInSec": {
          "type": "number",
          "minimum": 0
        },
        "fadeOutSec": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "src",
        "volume",
        "trimBeforeSec",
        "fadeInSec",
        "fadeOutSec"
      ]
    },
    "fps": {
      "type": "integer",
      "minimum": 24,
      "maximum": 60,
      "description": "帧率：预览 30，成片 60"
    },
    "format": {
      "description": "画幅，例如 16:9 或 9:16（由工程初始化时选择）",
      "type": "string",
      "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
    },
    "captions": {
      "maxItems": 24,
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "里程碑文案，按顺序对应 photos.milestones；\\n 换行"
    },
    "beatGrid": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "beats": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "required": [
            "beats"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "photos",
    "copy",
    "music",
    "fps",
    "captions"
  ]
}
