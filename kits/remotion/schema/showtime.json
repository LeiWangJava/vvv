{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "couple": {
      "type": "object",
      "properties": {
        "groom": {
          "type": "string",
          "description": "新郎姓名"
        },
        "bride": {
          "type": "string",
          "description": "新娘姓名"
        },
        "groomEn": {
          "type": "string",
          "description": "新郎英文名或拼音"
        },
        "brideEn": {
          "type": "string",
          "description": "新娘英文名或拼音"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "婚礼日期"
        },
        "tagline": {
          "type": "string",
          "description": "主标题"
        }
      },
      "required": [
        "groom",
        "bride",
        "groomEn",
        "brideEn",
        "date",
        "tagline"
      ]
    },
    "photos": {
      "type": "object",
      "properties": {
        "couple1": {
          "type": "string",
          "minLength": 1
        },
        "coupleA": {
          "type": "string",
          "minLength": 1
        },
        "coupleB": {
          "minItems": 1,
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mag": {
          "minItems": 3,
          "maxItems": 7,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "pairs": {
          "minItems": 2,
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "singles": {
          "minItems": 1,
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "finale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "couple1",
        "coupleA",
        "coupleB",
        "mag",
        "pairs",
        "singles",
        "finale"
      ]
    },
    "copy": {
      "type": "object",
      "properties": {
        "clip_open": {
          "type": "string",
          "description": "电影片段 · 开场（0–22.8 秒，约 22.8 秒；填 clips/文件名.mp4，可加 @起始秒 和 #sound 用片段原声）"
        },
        "w1": {
          "type": "string",
          "description": "欢迎 · 第 1 句（｜分两行）"
        },
        "w2": {
          "type": "string",
          "description": "欢迎 · 第 2 句"
        },
        "w3": {
          "type": "string",
          "description": "欢迎 · 第 3 句"
        },
        "w4": {
          "type": "string",
          "description": "欢迎 · 第 4 句"
        },
        "w5": {
          "type": "string",
          "description": "欢迎 · 第 5 句"
        },
        "clip_1": {
          "type": "string",
          "description": "电影片段 · 第 1 段（32.4–35.87 秒，约 3.5 秒；填 clips/文件名.mp4，可加 @起始秒 和 #sound 用片段原声）"
        },
        "w6": {
          "type": "string",
          "description": "开始 · 第 1 句"
        },
        "w7": {
          "type": "string",
          "description": "拍照 · 第 1 句"
        },
        "w8": {
          "type": "string",
          "description": "拍照 · 第 2 句"
        },
        "w9": {
          "type": "string",
          "description": "掌声 · 第 1 句"
        },
        "w10": {
          "type": "string",
          "description": "掌声 · 第 2 句"
        },
        "clip_2": {
          "type": "string",
          "description": "电影片段 · 第 2 段（46.17–48.83 秒，约 2.7 秒；填 clips/文件名.mp4，可加 @起始秒 和 #sound 用片段原声）"
        },
        "w11": {
          "type": "string",
          "description": "须知 · 散开的词（｜分隔）"
        },
        "w12": {
          "type": "string",
          "description": "须知 · 左右两个词（｜分隔）"
        },
        "w13": {
          "type": "string",
          "description": "须知 · 左右两个词"
        },
        "w14": {
          "type": "string",
          "description": "须知 · 左右两个词"
        },
        "w15": {
          "type": "string",
          "description": "须知 · 左右两个词"
        },
        "clip_3": {
          "type": "string",
          "description": "电影片段 · 第 3 段（55.97–57.77 秒，约 1.8 秒；填 clips/文件名.mp4，可加 @起始秒 和 #sound 用片段原声）"
        },
        "w16": {
          "type": "string",
          "description": "劝酒 · 第 1 句"
        },
        "w17": {
          "type": "string",
          "description": "劝酒 · 第 2 句"
        },
        "clip_4": {
          "type": "string",
          "description": "电影片段 · 第 4 段（不然他会……）（61.53–64.85 秒，约 3.3 秒；填 clips/文件名.mp4，可加 @起始秒 和 #sound 用片段原声）"
        },
        "c0": {
          "type": "string",
          "description": "倒计时 · 开始"
        },
        "x1": {
          "type": "string",
          "description": "快闪 1（红）"
        },
        "x2": {
          "type": "string",
          "description": "快闪 2（白）"
        },
        "x3": {
          "type": "string",
          "description": "快闪 3（红）"
        },
        "x4": {
          "type": "string",
          "description": "快闪 4（白）"
        },
        "x5": {
          "type": "string",
          "description": "快闪 5（白）"
        },
        "x6": {
          "type": "string",
          "description": "快闪 6（红）"
        },
        "x7": {
          "type": "string",
          "description": "快闪 7（白）"
        },
        "x8": {
          "type": "string",
          "description": "快闪 8（红）"
        },
        "x9": {
          "type": "string",
          "description": "快闪 9（白）"
        },
        "x10": {
          "type": "string",
          "description": "快闪 10（红）"
        },
        "x11": {
          "type": "string",
          "description": "快闪 11（白）"
        },
        "x12": {
          "type": "string",
          "description": "快闪 12（红）"
        },
        "x13": {
          "type": "string",
          "description": "日期之前"
        },
        "x14": {
          "type": "string",
          "description": "名字之后 · 1（白）"
        },
        "x15": {
          "type": "string",
          "description": "名字之后 · 2（红）"
        },
        "x16": {
          "type": "string",
          "description": "名字之后 · 3（白）"
        },
        "gi1": {
          "type": "string",
          "description": "新郎 · 第 1 句（左右两个词）"
        },
        "gi2": {
          "type": "string",
          "description": "新郎 · 夸奖 1"
        },
        "gi3": {
          "type": "string",
          "description": "新郎 · 夸奖 2"
        },
        "gi4": {
          "type": "string",
          "description": "新郎 · 夸奖 3"
        },
        "gi5": {
          "type": "string",
          "description": "新郎 · 夸奖 4"
        },
        "gi6": {
          "type": "string",
          "description": "新郎 · 滚动大字"
        },
        "clip_groom": {
          "type": "string",
          "description": "电影片段 · 新郎登场（89.63–98.83 秒，约 9.2 秒；填 clips/文件名.mp4，可加 @起始秒 和 #sound 用片段原声）"
        },
        "g1": {
          "type": "string",
          "description": "新郎 · 搞错了"
        },
        "g2": {
          "type": "string",
          "description": "新郎 · 真正的新郎"
        },
        "clip_5": {
          "type": "string",
          "description": "电影片段 · 第 5 段（105.93–109.4 秒，约 3.5 秒；填 clips/文件名.mp4，可加 @起始秒 和 #sound 用片段原声）"
        },
        "bi1": {
          "type": "string",
          "description": "新娘 · 第 1 句"
        },
        "bi2": {
          "type": "string",
          "description": "新娘 · 夸奖 1（左右两个词）"
        },
        "bi3": {
          "type": "string",
          "description": "新娘 · 夸奖 2"
        },
        "bi4": {
          "type": "string",
          "description": "新娘 · 夸奖 3"
        },
        "bi5": {
          "type": "string",
          "description": "新娘 · 夸奖 4"
        },
        "bi6": {
          "type": "string",
          "description": "新娘 · 夸奖 5"
        },
        "bi7": {
          "type": "string",
          "description": "新娘 · 名字（{bride} 自动换成新娘名字）"
        },
        "clip_bride": {
          "type": "string",
          "description": "电影片段 · 新娘登场（116.97–132.23 秒，约 15.3 秒；填 clips/文件名.mp4，可加 @起始秒 和 #sound 用片段原声）"
        },
        "clip_6": {
          "type": "string",
          "description": "电影片段 · 第 6 段（135.83–138.97 秒，约 3.1 秒；填 clips/文件名.mp4，可加 @起始秒 和 #sound 用片段原声）"
        },
        "h1": {
          "type": "string",
          "description": "见证 · 第 1 句"
        },
        "h2": {
          "type": "string",
          "description": "见证 · 第 2 句"
        },
        "mag_script": {
          "type": "string",
          "description": "婚纱照杂志 · 手写标题"
        },
        "mag_cap": {
          "type": "string",
          "description": "婚纱照杂志 · 底部大字（换图前｜换图后）"
        },
        "mag_header": {
          "type": "string",
          "description": "婚纱照杂志 · 第二页顶部的字"
        },
        "count": {
          "type": "string",
          "description": "婚纱照之间 · 标题"
        },
        "finale": {
          "type": "string",
          "description": "结尾 · 感谢"
        },
        "sfx": {
          "type": "string",
          "description": "模板音效（开 / 关；用整轨原配乐时填 关）"
        }
      },
      "required": [
        "clip_open",
        "w1",
        "w2",
        "w3",
        "w4",
        "w5",
        "clip_1",
        "w6",
        "w7",
        "w8",
        "w9",
        "w10",
        "clip_2",
        "w11",
        "w12",
        "w13",
        "w14",
        "w15",
        "clip_3",
        "w16",
        "w17",
        "clip_4",
        "c0",
        "x1",
        "x2",
        "x3",
        "x4",
        "x5",
        "x6",
        "x7",
        "x8",
        "x9",
        "x10",
        "x11",
        "x12",
        "x13",
        "x14",
        "x15",
        "x16",
        "gi1",
        "gi2",
        "gi3",
        "gi4",
        "gi5",
        "gi6",
        "clip_groom",
        "g1",
        "g2",
        "clip_5",
        "bi1",
        "bi2",
        "bi3",
        "bi4",
        "bi5",
        "bi6",
        "bi7",
        "clip_bride",
        "clip_6",
        "h1",
        "h2",
        "mag_script",
        "mag_cap",
        "mag_header",
        "count",
        "finale",
        "sfx"
      ]
    },
    "music": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string",
          "description": "public/ 下的音乐路径，如 music/xxx.mp3；留空为无声"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "音量"
        },
        "trimBeforeSec": {
          "type": "number",
          "minimum": 0,
          "description": "从音乐第几秒开始"
        },
        "fadeInSec": {
          "type": "number",
          "minimum": 0
        },
        "fadeOutSec": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "src",
        "volume",
        "trimBeforeSec",
        "fadeInSec",
        "fadeOutSec"
      ]
    },
    "fps": {
      "type": "integer",
      "minimum": 24,
      "maximum": 60,
      "description": "帧率：预览 30，成片 60"
    },
    "format": {
      "description": "画幅，例如 16:9 或 9:16（由工程初始化时选择）",
      "type": "string",
      "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
    }
  },
  "required": [
    "couple",
    "photos",
    "copy",
    "music",
    "fps"
  ]
}
