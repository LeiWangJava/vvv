{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "couple": {
      "type": "object",
      "properties": {
        "groom": {
          "type": "string",
          "description": "新郎姓名"
        },
        "bride": {
          "type": "string",
          "description": "新娘姓名"
        },
        "groomEn": {
          "type": "string",
          "description": "新郎英文名或拼音"
        },
        "brideEn": {
          "type": "string",
          "description": "新娘英文名或拼音"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "婚礼日期"
        },
        "tagline": {
          "type": "string",
          "description": "主标题"
        }
      },
      "required": [
        "groom",
        "bride",
        "groomEn",
        "brideEn",
        "date",
        "tagline"
      ]
    },
    "photos": {
      "type": "object",
      "properties": {
        "couple1": {
          "type": "string",
          "minLength": 1
        },
        "groomKid": {
          "type": "string",
          "minLength": 1
        },
        "groomHero": {
          "type": "string",
          "minLength": 1
        },
        "coupleA": {
          "type": "string",
          "minLength": 1
        },
        "brideKid": {
          "type": "string",
          "minLength": 1
        },
        "brideHero": {
          "type": "string",
          "minLength": 1
        },
        "coupleB": {
          "type": "string",
          "minLength": 1
        },
        "mag": {
          "minItems": 3,
          "maxItems": 9,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "slides": {
          "minItems": 4,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "finale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "couple1",
        "groomKid",
        "groomHero",
        "coupleA",
        "brideKid",
        "brideHero",
        "coupleB",
        "mag",
        "slides",
        "finale"
      ]
    },
    "copy": {
      "type": "object",
      "properties": {
        "ident_search": {
          "type": "string",
          "description": "片头 · 搜索信号（雪花屏下方）"
        },
        "ident_bars": {
          "type": "string",
          "description": "片头 · 彩条上的字"
        },
        "ident_channel": {
          "type": "string",
          "description": "片头 · 频道名（新人名字下面）"
        },
        "ident_go": {
          "type": "string",
          "description": "片头 · 两行大字（用｜分行）"
        },
        "w1": {
          "type": "string",
          "description": "欢迎 · 第 1 句（｜分两行）"
        },
        "w2": {
          "type": "string",
          "description": "欢迎 · 第 2 句"
        },
        "w3": {
          "type": "string",
          "description": "欢迎 · 第 3 句"
        },
        "w4": {
          "type": "string",
          "description": "欢迎 · 第 4 句"
        },
        "w5": {
          "type": "string",
          "description": "欢迎 · 第 5 句"
        },
        "g1": {
          "type": "string",
          "description": "笑点 · 指向观众"
        },
        "w6": {
          "type": "string",
          "description": "欢迎 · 第 6 句"
        },
        "w7": {
          "type": "string",
          "description": "拍照 · 第 1 句"
        },
        "snap": {
          "type": "string",
          "description": "拍照 · 咔嚓（照片下方）"
        },
        "w8": {
          "type": "string",
          "description": "拍照 · 第 2 句"
        },
        "w9": {
          "type": "string",
          "description": "掌声 · 第 1 句"
        },
        "w10": {
          "type": "string",
          "description": "掌声 · 第 2 句"
        },
        "g2": {
          "type": "string",
          "description": "笑点 · 掌声"
        },
        "w11": {
          "type": "string",
          "description": "须知 · 第 1 句"
        },
        "w12": {
          "type": "string",
          "description": "须知 · 左右两个词（｜分隔）"
        },
        "w13": {
          "type": "string",
          "description": "须知 · 左右两个词"
        },
        "w14": {
          "type": "string",
          "description": "须知 · 左右两个词"
        },
        "g3": {
          "type": "string",
          "description": "笑点 · 美食雨"
        },
        "w15": {
          "type": "string",
          "description": "须知 · 劝酒"
        },
        "w16": {
          "type": "string",
          "description": "须知 · 不然"
        },
        "g4": {
          "type": "string",
          "description": "笑点 · 新郎喝多（右侧两行）"
        },
        "c0": {
          "type": "string",
          "description": "倒计时 · 开始"
        },
        "x1": {
          "type": "string",
          "description": "倒计时 · 快闪 1（红）"
        },
        "x2": {
          "type": "string",
          "description": "倒计时 · 快闪 2（白）"
        },
        "x3": {
          "type": "string",
          "description": "倒计时 · 快闪 3（红）"
        },
        "x4": {
          "type": "string",
          "description": "倒计时 · 快闪 4（白）"
        },
        "x5": {
          "type": "string",
          "description": "倒计时 · 快闪 5（红）"
        },
        "x6": {
          "type": "string",
          "description": "倒计时 · 快闪 6（白）"
        },
        "x7": {
          "type": "string",
          "description": "倒计时 · 快闪 7（红）"
        },
        "x8": {
          "type": "string",
          "description": "倒计时 · 快闪 8（白）"
        },
        "hl": {
          "type": "string",
          "description": "倒计时 · 名字之后（白）"
        },
        "gi1": {
          "type": "string",
          "description": "新郎 · 第 1 句"
        },
        "gi2": {
          "type": "string",
          "description": "新郎 · 第 2 句"
        },
        "gi3": {
          "type": "string",
          "description": "新郎 · 夸奖 1（左右两个词）"
        },
        "gi4": {
          "type": "string",
          "description": "新郎 · 夸奖 2"
        },
        "gi5": {
          "type": "string",
          "description": "新郎 · 夸奖 3"
        },
        "gi6": {
          "type": "string",
          "description": "新郎 · 夸奖 4"
        },
        "gcall": {
          "type": "string",
          "description": "新郎 · 有请"
        },
        "gfake": {
          "type": "string",
          "description": "新郎 · 搞错人（三句：小时候照片 → 定格 → 倒带）"
        },
        "greal": {
          "type": "string",
          "description": "新郎 · 真正登场"
        },
        "groom_role": {
          "type": "string",
          "description": "新郎 · 名牌称呼"
        },
        "bi1": {
          "type": "string",
          "description": "新娘 · 第 1 句"
        },
        "bi2": {
          "type": "string",
          "description": "新娘 · 第 2 句"
        },
        "bi3": {
          "type": "string",
          "description": "新娘 · 夸奖 1（左右两个词）"
        },
        "bi4": {
          "type": "string",
          "description": "新娘 · 夸奖 2"
        },
        "bi5": {
          "type": "string",
          "description": "新娘 · 夸奖 3"
        },
        "bi6": {
          "type": "string",
          "description": "新娘 · 夸奖 4"
        },
        "bi7": {
          "type": "string",
          "description": "新娘 · 夸奖 5"
        },
        "bname": {
          "type": "string",
          "description": "新娘 · 名字（{bride} 自动换成新娘名字）"
        },
        "bcall": {
          "type": "string",
          "description": "新娘 · 有请"
        },
        "bfake": {
          "type": "string",
          "description": "新娘 · 放大镜（两句）"
        },
        "bride_role": {
          "type": "string",
          "description": "新娘 · 名牌称呼"
        },
        "coupleA_cap": {
          "type": "string",
          "description": "新郎之后的合照 · 字"
        },
        "coupleB_cap": {
          "type": "string",
          "description": "新娘之后的合照 · 字"
        },
        "witness": {
          "type": "string",
          "description": "见证（两句）"
        },
        "mag_title": {
          "type": "string",
          "description": "婚纱照杂志 · 手写标题（三页用｜分隔）"
        },
        "mag_cap": {
          "type": "string",
          "description": "婚纱照杂志 · 底部大字（三页用｜分隔）"
        },
        "count": {
          "type": "string",
          "description": "婚纱照之间 · 倒计时标题"
        },
        "finale": {
          "type": "string",
          "description": "结尾 · 感谢"
        }
      },
      "required": [
        "ident_search",
        "ident_bars",
        "ident_channel",
        "ident_go",
        "w1",
        "w2",
        "w3",
        "w4",
        "w5",
        "g1",
        "w6",
        "w7",
        "snap",
        "w8",
        "w9",
        "w10",
        "g2",
        "w11",
        "w12",
        "w13",
        "w14",
        "g3",
        "w15",
        "w16",
        "g4",
        "c0",
        "x1",
        "x2",
        "x3",
        "x4",
        "x5",
        "x6",
        "x7",
        "x8",
        "hl",
        "gi1",
        "gi2",
        "gi3",
        "gi4",
        "gi5",
        "gi6",
        "gcall",
        "gfake",
        "greal",
        "groom_role",
        "bi1",
        "bi2",
        "bi3",
        "bi4",
        "bi5",
        "bi6",
        "bi7",
        "bname",
        "bcall",
        "bfake",
        "bride_role",
        "coupleA_cap",
        "coupleB_cap",
        "witness",
        "mag_title",
        "mag_cap",
        "count",
        "finale"
      ]
    },
    "music": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string",
          "description": "public/ 下的音乐路径，如 music/xxx.mp3；留空为无声"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "音量"
        },
        "trimBeforeSec": {
          "type": "number",
          "minimum": 0,
          "description": "从音乐第几秒开始"
        },
        "fadeInSec": {
          "type": "number",
          "minimum": 0
        },
        "fadeOutSec": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "src",
        "volume",
        "trimBeforeSec",
        "fadeInSec",
        "fadeOutSec"
      ]
    },
    "fps": {
      "type": "integer",
      "minimum": 24,
      "maximum": 60,
      "description": "帧率：预览 30，成片 60"
    },
    "format": {
      "description": "画幅，例如 16:9 或 9:16（由工程初始化时选择）",
      "type": "string",
      "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
    },
    "beatGrid": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "beats": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "required": [
            "beats"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "couple",
    "photos",
    "copy",
    "music",
    "fps"
  ]
}
