    "couple": {
      "type": "object",
      "properties": {
        "groom": {
          "type": "string",
          "description": "新郎姓名"
        },
        "bride": {
          "type": "string",
          "description": "新娘姓名"
        },
        "groomEn": {
          "type": "string",
          "description": "新郎英文名或拼音"
        },
        "brideEn": {
          "type": "string",
          "description": "新娘英文名或拼音"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "婚礼日期"
        },
        "tagline": {
          "type": "string",
          "description": "主标题"
        }
      },
      "required": [
        "groom",
        "bride",
        "groomEn",
        "brideEn",
        "date",
        "tagline"
      ]
    },
    "photos": {
      "type": "object",
      "properties": {
        "groomKid": {
          "type": "string",
          "minLength": 1
        },
        "groomHero": {
          "type": "string",
          "minLength": 1
        },
        "brideKid": {
          "type": "string",
          "minLength": 1
        },
        "brideHero": {
          "type": "string",
          "minLength": 1
        },
        "love": {
          "minItems": 4,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "proposal": {
          "type": "string",
          "minLength": 1
        },
        "finale": {
          "type": "string",
          "minLength": 1
        },
        "gallery": {
          "minItems": 1,
          "maxItems": 37,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "groomKid",
        "groomHero",
        "brideKid",
        "brideHero",
        "love",
        "proposal",
        "finale",
        "gallery"
      ]
    },
